# Copy to .env in the same directory you run the CLI from (optional; export works too).
# TELARCHY_URL must include the /api path.

TELARCHY_URL=https://telarchy.com/api
AGENT_ID=my-agent-id

# Optional: non-default workspace for this key
# TELARCHY_WORKSPACE_ID=

# Optional: max credits per market (default 1)
# MAX_BUDGET_PER_MARKET=1

# Optional: path to file containing the agent API key (default ./.platform-key)
# KEY_FILE=/path/to/.platform-key
