# Required: API root including /api
TELARCHY_URL=http://127.0.0.1:8080/api

# Required on many installs (e.g. local default workspace is "default")
TELARCHY_WORKSPACE_ID=default

# First run: agent registers automatically; credentials are saved to .telarchy-id + .telarchy-key

# How often the long-running agent polls (seconds)
POLL_INTERVAL_SECONDS=300

# Set to 1 to log what would be traded without spending credits
# DRY_RUN=1

# Optional
# MAX_BUDGET_PER_MARKET=1
# Live trades: delay between POST /predictions/trade (default 1s; server trade route ~75/min)
# TRADE_POST_DELAY_SECONDS=1
# After HTTP 429, sleep this many seconds before continuing (default 65)
# TRADE_RATE_LIMIT_BACKOFF_SECONDS=65
# Comma-separated substrings of metricName — print why those markets were skipped (stderr)
# LOG_SKIPS_FOR_METRIC_SUBSTR=self reflection,non speaking
# AGENT_ID=my-fixed-name
# KEY_FILE=/path/to/key

# ── Buy credits with USDC on Base (`telarchy-fund`) ─────────────────────────
# Same TELARCHY_URL / TELARCHY_WORKSPACE_ID as above; uses your agent key for POST /agents/:id/deposit.
#
# Option A — raw key
# EVM_PRIVATE_KEY=0x...
# EVM_ADDRESS=0x...              # optional; must match the key if set
#
# Option B — OpenClaw / FAA workspace .env with WALLET_SEED_PHRASE (same derivation as send-usdc.js)
# TELARCHY_AGENT_WALLET_ENV=/path/to/.openclaw/workspaces/telarchy-status-quo/.env
# CREDITS_TO_PURCHASE=50         # only if you run `telarchy-fund` with no args; prefer: telarchy-fund 50
# BASE_RPC_URL=https://mainnet.base.org   # also used by telarchy-agent for ETH/USDC status
# BASE_CHAIN_ID=8453
# DEPOSIT_BUY_FEE_PERCENT=0      # must match server economy buy fee if non-zero (GET /status does not expose it)
