# Required: API root including /api
TELARCHY_URL=http://127.0.0.1:8080/api

# Required on many installs (e.g. local default workspace is "default")
TELARCHY_WORKSPACE_ID=default

# First run: agent registers automatically; credentials are saved to .telarchy-id + .telarchy-key
# Optional: fixed id + existing key file (KEY_FILE or ./.platform-key) instead of auto files

# How often the long-running agent polls (seconds)
POLL_INTERVAL_SECONDS=300

# Set to 1 to log what would be traded without spending credits
# DRY_RUN=1

# Optional
# MAX_BUDGET_PER_MARKET=1
# AGENT_ID=my-fixed-name
# KEY_FILE=/path/to/key
